# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env or backend/token.txt.

# PostgreSQL / Supabase connection string.
# Example: postgresql+psycopg://user:password@host:5432/dbname
# On hosts without IPv6, prefer the Supabase pooler URL (port 6543).
DATABASE_URL=

# JWT settings. Use a long random string (32+ characters) in production.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Initial admin account used by `python seed_admin.py`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Comma-separated list of allowed browser origins.
# Use your real domain(s) in production, e.g. https://tsarawatsar.school
ALLOWED_ORIGINS=*
