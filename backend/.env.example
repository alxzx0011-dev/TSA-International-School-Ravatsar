# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env or backend/token.txt.

# PostgreSQL / Supabase connection string.
# Example: postgresql+psycopg://user:password@host:5432/dbname
# On hosts without IPv6, prefer the Supabase pooler URL (port 6543).
DATABASE_URL=

# JWT settings. Use a long random string (32+ characters) in production.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Initial admin account used by `python seed_admin.py`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Comma-separated list of allowed browser origins.
# Use your real domain(s) in production, e.g. https://tsarawatsar.school
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Email — used to send password reset codes.
#
# Render's FREE tier blocks outbound SMTP (ports 25/465/587), so use an HTTP
# email API on Render: Brevo, Resend or SendGrid.
# For local development you can also use SMTP, or EMAIL_DEV_MODE=true.
#
# EMAIL_PROVIDER = brevo | resend | sendgrid | smtp | none
# EMAIL_API_KEY  = API key for Brevo / Resend / SendGrid
# EMAIL_FROM     = sender address (must be verified with the provider)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=TSA International School

# Only for SMTP (local development or a paid Render instance).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=TSA International School
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Local testing only: prints the email (including the OTP) in the server
# console instead of sending it. Keep this false in production.
EMAIL_DEV_MODE=false
