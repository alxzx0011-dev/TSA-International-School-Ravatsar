# Copy this file to backend/.env.migrate and fill in the real connection strings.
# Never commit backend/.env.migrate.
#
# Use the Supabase *pooler* URL (port 6543) of each project and add +psycopg
# after "postgresql", for example:
# postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# See the "Move Supabase to a nearby region" section of README.md.

# Old (current) project the site uses today.
SOURCE_DATABASE_URL=

# New (nearby) project that should become the live database.
TARGET_DATABASE_URL=
